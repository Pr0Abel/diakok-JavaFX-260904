<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_RIGHT" prefHeight="400.0" prefWidth="600.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.example.diakok.DiakokController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="585.0" prefWidth="735.0">
      <children>
         <VBox alignment="TOP_CENTER" prefHeight="315.0" prefWidth="266.0">
            <children>
               <ImageView fitHeight="119.0" fitWidth="145.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@diak.png" />
                  </image>
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </ImageView>
               <Button mnemonicParsing="false" prefWidth="76.0" text="Mindenki">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" prefWidth="76.0" text="Sándorok">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" text="Kecskeméti">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" prefWidth="76.0" text="1996">
                  <VBox.margin>
                     <Insets bottom="10.0" />
                  </VBox.margin>
               </Button>
               <Button mnemonicParsing="false" prefWidth="76.0" text="10/A" />
            </children>
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </VBox>
         <ListView prefHeight="315.0" prefWidth="733.0" />
      </children>
   </HBox>
    <Button onAction="#onHelloButtonClick" text="Lista mentése" />
</VBox>
